#Inputs from User
project_id = input("Provide project id to store data shared with unravel.\n").strip()
dataset_id = input("Provide dataset to store data shared with unravel:\n").strip()

# Validate dataset_id: BigQuery dataset IDs must be alphanumeric + underscores, max 1024 chars
if not re.match(r'^[a-zA-Z0-9_]{1,1024}$', dataset_id):
    raise ValueError(
        f"Invalid dataset ID '{dataset_id}'. "
        "BigQuery dataset IDs must be alphanumeric (plus underscores) and at most 1024 characters long. "
        "Hyphens are NOT allowed. Example: 'unravel_share_US' instead of 'unravel-share-US'."
    )

# Refresh frequency — default 24 hours if left blank
projects_refresh_input = input(
    "Provide refresh interval (in hours) for Projects data [default: 24]:\n").strip()
PROJECTS_REFRESH_INTERVAL_HOURS = int(projects_refresh_input) if projects_refresh_input else 24

scheduled_jobs_refresh_input = input(
    "Provide refresh interval (in hours) for Scheduled Job Details data [default: 24]:\n").strip()
SCHEDULED_JOBS_REFRESH_INTERVAL_HOURS = int(scheduled_jobs_refresh_input) if scheduled_jobs_refresh_input else 24

print(f"\nConfiguration:")
print(f"  PROJECTS_REFRESH_INTERVAL_HOURS      = {PROJECTS_REFRESH_INTERVAL_HOURS}")
print(f"  SCHEDULED_JOBS_REFRESH_INTERVAL_HOURS = {SCHEDULED_JOBS_REFRESH_INTERVAL_HOURS}")

# Fetch project list from a BigQuery table instead of comma-separated input
projects_table = input(
    "\nProvide the fully qualified table name containing project IDs to fetch data for.\n"
    "e.g.: my-project.my_dataset.monitored_projects\n"
    "The table must have a column named 'project_id'.\n").strip().strip('`')

client = bigquery.Client(project=project_id)

print(f"\nFetching project list from `{projects_table}`...")
try:
    projects_query = f"SELECT project_id FROM `{projects_table}`"
    query_job = client.query(projects_query)
    rows = list(query_job.result())
    projects_to_fetch = [row.project_id for row in rows if row.project_id]
    if not projects_to_fetch:
        raise ValueError("No project IDs found in the table.")
    print(f"Found {len(projects_to_fetch)} projects: {projects_to_fetch}")
except Exception as e:
    print(f"Error fetching project list from `{projects_table}`: {e}")
    print("Exiting.")
    raise SystemExit(1)

# DDL for scheduled_job_details columns (shared between main and temp tables)
SCHEDULED_JOB_COLUMNS = """
project STRING,
name STRING,
display_name STRING,
data_source_id STRING,
params JSON,
schedule STRING,
schedule_options struct<disable_auto_scheduling BOOLEAN, start_time string, end_time string>,
schedule_options_V2 struct<time_based_schedule struct<schedule string, start_time string, end_time string>, manual_schedule json, event_driven_schedule struct<pubsub_subscription string>>,
data_refresh_window_days INTEGER,
disabled BOOLEAN,
update_time STRING,
next_run_time STRING,
state STRING,
user_id STRING,
dataset_region STRING,
notification_pubsub_topic STRING,
email_preferences struct<enable_failure_email BOOLEAN>,
encryption_configuration struct<kms_key_name string>,
error struct<code INTEGER, message string, details array<JSON>>,
destination_dataset_id STRING,
owner_info struct<email string>"""

create_table_queries = [
    f"""CREATE TABLE IF NOT EXISTS `{project_id}.{dataset_id}.project_details` (
        project_number string, project_id string, lifecycle_state string,
        name string, create_time string, labels JSON,
        parent struct<type string, id string>, tags JSON)""",

    f"""CREATE TABLE IF NOT EXISTS `{project_id}.{dataset_id}.scheduled_job_details` ({SCHEDULED_JOB_COLUMNS})""",

    f"""CREATE TABLE IF NOT EXISTS `{project_id}.{dataset_id}.scheduled_job_details_temp` ({SCHEDULED_JOB_COLUMNS})""",

    f"""CREATE TABLE IF NOT EXISTS `{project_id}.{dataset_id}.ancestor_details` (
        ancestor array<struct<resource_id struct<type string, id string>>>)"""]

#checks project exists or not
def is_project_exists():
    resourceManagerClient = resourcemanager_v3.ProjectsClient()
    try:
        project = resourceManagerClient.get_project(name=f'projects/{project_id}')
        return True
    except NotFound:
        print(f"Project {project_id} does not exist. Provide different project")
        return False
    except Exception as e:
        print(f"Error getting project status {e}")
        return False

#checks dataset exists or not, creates if not
def ensure_dataset_exists(client):
    try:
        client.get_dataset(f"{project_id}.{dataset_id}")
        print(f"Dataset {dataset_id} already exists.")
        return True
    except NotFound:
        try:
            print(f"Dataset {dataset_id} does not exist. Creating...")
            dataset = bigquery.Dataset(f"{project_id}.{dataset_id}")
            dataset.location = 'US'
            client.create_dataset(dataset)
            print(f"Dataset {dataset_id} created successfully.")
            return True
        except Exception as e:
            print(f"Error while creating dataset: {e}")
            return False
    except Exception as e:
        print(f"Error checking dataset: {e}")
        return False

#verifying the tables created or not
def verifyTables(client):
    tables = ['project_details', 'ancestor_details', 'scheduled_job_details', 'scheduled_job_details_temp']
    time.sleep(5)
    for table in tables:
        if not check_table_exists(client, project_id, dataset_id, table):
            print(f"Table {table} not ready yet, retrying...")
            retries = 5
            for attempt in range(retries):
                time.sleep(5)
                if check_table_exists(client, project_id, dataset_id, table):
                    print(f"Table {table} is now available.")
                    break
            else:
                print(f"Table {table} was not created successfully after {retries} retries.")
                return False
        else:
            print(f"Table {table} is already available.")
    return True

if is_project_exists():
    if ensure_dataset_exists(client):
        tableCreatedNumber = create_tables(create_table_queries, client)
        if tableCreatedNumber == len(create_table_queries):
            if verifyTables(client):
                storeToBQTable(client, projects_to_fetch, project_id, dataset_id)
